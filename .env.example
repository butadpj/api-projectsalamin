# Required at runtime. Use Supabase's pooled Postgres connection string.
POSTGRES_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=require"

# Required for migrations. Use Supabase's direct/non-pooling connection string.
POSTGRES_URL_NON_POOLING="postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require"

# Required in production. Comma-separate additional allowed frontend origins.
ALLOWED_ORIGINS="http://localhost:5173"

# Optional. The deployment host normally supplies PORT.
PORT="3001"

# Optional. Set one only if the environment requires an explicit Supabase CA.
SUPABASE_DB_CA_CERT=""
SUPABASE_DB_CA_CERT_PATH=""
